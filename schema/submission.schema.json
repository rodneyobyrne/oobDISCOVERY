{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.oobcreative.com/schema/clinician-submission-v1.json",
  "title": "oobDISCOVERY Clinician Submission",
  "type": "object",
  "required": ["submissionId", "system", "discoveryType", "questionnaireVersion", "client", "respondent", "timing", "archetypes", "patientPatterns", "narrative", "sourceIntegrity"],
  "properties": {
    "submissionId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "system": { "const": "oobDISCOVERY" },
    "discoveryType": { "const": "clinician" },
    "systemVersion": { "type": "string" },
    "questionnaireVersion": { "type": "string" },
    "client": {
      "type": "object",
      "required": ["id", "label"],
      "properties": { "id": {"type":"string"}, "label": {"type":"string"} },
      "additionalProperties": false
    },
    "respondent": {
      "type": "object",
      "required": ["name", "email", "role", "perspective"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "maxLength": 254 },
        "role": { "type": "string", "minLength": 1 },
        "perspective": { "enum": ["clinician", "owner", "both"] }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["startedAt", "generatedAt"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "title", "situation", "relationship", "caseload", "websitePriority", "note"],
        "properties": {
          "id": {"type":"string"}, "title": {"type":"string"}, "situation": {"type":"string"},
          "relationship": {"enum":["", "can-serve", "strong-fit", "refer", "unsure"]},
          "caseload": {"enum":["", "more", "neutral", "less"]},
          "websitePriority": {"enum":["", "yes", "no"]},
          "note": {"type":"string"}
        },
        "additionalProperties": false
      }
    },
    "patientPatterns": { "type": "array", "maxItems": 10, "items": { "type": "object", "maxProperties": 40, "additionalProperties": {"type":"string", "maxLength": 10000} } },
    "narrative": { "type": "object", "maxProperties": 100, "additionalProperties": { "type": "string", "maxLength": 10000 } },
    "sourceIntegrity": {
      "type": "object",
      "required": ["responseType", "patientIdentifyingInformationRequested", "interpretationIncluded", "respondentHypothesisIncluded", "evidenceModel"],
      "properties": {
        "responseType": { "const": "clinician-self-report" },
        "patientIdentifyingInformationRequested": { "const": false },
        "interpretationIncluded": { "const": false },
        "respondentHypothesisIncluded": { "const": true },
        "evidenceModel": { "const": "reported-observation-and-informed-hypothesis" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
