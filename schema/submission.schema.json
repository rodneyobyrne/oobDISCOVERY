{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discovery.oobcreative.com/schema/clinical-audience-mapping-submission-v5.json",
  "title": "oobDISCOVERY Clinical Audience Mapping Submission",
  "type": "object",
  "required": ["submissionId", "system", "discoveryType", "questionnaireVersion", "client", "respondent", "timing", "services", "audiences", "patientPatterns", "narrative", "sourceIntegrity"],
  "properties": {
    "submissionId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "system": { "const": "oobDISCOVERY" },
    "discoveryType": { "const": "clinician" },
    "systemVersion": { "type": "string" },
    "questionnaireVersion": { "type": "string", "pattern": "-v5$" },
    "client": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "label": { "type": "string", "maxLength": 160 }
      },
      "additionalProperties": false
    },
    "respondent": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "email": { "type": "string", "maxLength": 254 }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["startedAt", "generatedAt"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "required": ["offered", "recipients", "currentPopulation", "intendedPopulation", "boundaries"],
      "properties": {
        "offered": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 240 }
        },
        "recipients": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 240 }
        },
        "currentPopulation": { "type": "string", "maxLength": 10000 },
        "intendedPopulation": { "type": "string", "maxLength": 10000 },
        "boundaries": { "type": "string", "maxLength": 10000 }
      },
      "additionalProperties": false
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "title", "situation"],
        "properties": {
          "id": { "type": "string", "maxLength": 80 },
          "title": { "type": "string", "maxLength": 240 },
          "situation": { "type": "string", "maxLength": 10000 }
        },
        "additionalProperties": false
      }
    },
    "patientPatterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["audienceId", "sourceArchetypeId", "sourceArchetypeTitle", "sourceArchetypeSummary", "reviewDecision", "therapyScope", "audienceBasis", "evidenceSources", "clinicalContext", "workingLabel", "centralTension", "helpSeekingThreshold", "functionAndCost", "observedAndPrivate", "ambivalence", "trustBridge", "decisionSystem", "languageSignals", "healingDirectionAndFit", "distinction"],
        "properties": {
          "audienceId": { "type": "string", "maxLength": 80 },
          "sourceArchetypeId": { "type": "string", "maxLength": 80 },
          "sourceArchetypeTitle": { "type": "string", "maxLength": 240 },
          "sourceArchetypeSummary": { "type": "string", "maxLength": 1600 },
          "reviewDecision": { "type": "string", "maxLength": 240 },
          "therapyScope": { "type": "string", "maxLength": 240 },
          "audienceBasis": { "type": "string", "maxLength": 240 },
          "evidenceSources": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 240 }
          },
          "clinicalContext": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 240 }
          },
          "workingLabel": { "type": "string", "maxLength": 240 },
          "centralTension": { "type": "string", "maxLength": 10000 },
          "helpSeekingThreshold": { "type": "string", "maxLength": 10000 },
          "functionAndCost": { "type": "string", "maxLength": 10000 },
          "observedAndPrivate": { "type": "string", "maxLength": 10000 },
          "ambivalence": { "type": "string", "maxLength": 10000 },
          "trustBridge": { "type": "string", "maxLength": 10000 },
          "decisionSystem": { "type": "string", "maxLength": 10000 },
          "languageSignals": { "type": "string", "maxLength": 10000 },
          "healingDirectionAndFit": { "type": "string", "maxLength": 10000 },
          "distinction": { "type": "string", "maxLength": 10000 }
        },
        "additionalProperties": false
      }
    },
    "narrative": {
      "type": "object",
      "required": ["honestPromise"],
      "properties": {
        "honestPromise": { "type": "string", "maxLength": 10000 }
      },
      "additionalProperties": false
    },
    "sourceIntegrity": {
      "type": "object",
      "required": ["responseType", "patientIdentifyingInformationRequested", "interpretationIncluded", "respondentHypothesisIncluded", "archetypeGenerated", "diagnosticAssessment", "evidenceModel"],
      "properties": {
        "responseType": { "const": "clinical-audience-mapping-response" },
        "patientIdentifyingInformationRequested": { "const": false },
        "interpretationIncluded": { "const": false },
        "respondentHypothesisIncluded": { "const": true },
        "archetypeGenerated": { "const": false },
        "diagnosticAssessment": { "const": false },
        "evidenceModel": { "const": "clinician-reported-observation-inference-and-intended-audience-hypothesis" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
